<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:id="@+id/txtLogoBadge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_badge_circle"
                    android:gravity="center"
                    android:text="DN"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <ImageView
                    android:id="@+id/imgAppLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DANA Bisnis"
                    android:textStyle="bold"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30, 21 Okt 2026"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtNominal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Rp 50.000"
                android:textStyle="bold"
                android:textColor="@color/successColor"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/txtSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengirim: Budi Santoso"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detail notifikasi..."
            android:textSize="12sp"
            android:textColor="@color/textColorSecondary"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
